# Caddy 反向代理（自动申请并续期 HTTPS）
#
# 安装：sudo apt install -y caddy
# 使用：把下面两处 your-domain.com 换成你的域名，然后
#   sudo cp docker/prod/Caddyfile /etc/caddy/Caddyfile
#   sudo caddy validate --config /etc/caddy/Caddyfile
#   sudo systemctl reload caddy
#
# 说明：flush_interval -1 关闭响应缓冲，分析和 Agent 对话依赖 SSE 实时推送，
# 少了这一行页面会一直转圈直到任务结束才刷新。

your-domain.com {
	encode zstd gzip

	# 图片/CSV 导入
	request_body {
		max_size 20MB
	}

	reverse_proxy 127.0.0.1:8000 {
		flush_interval -1
		# 分析可能跑几分钟，长连接不要提前断
		transport http {
			read_timeout 3600s
			write_timeout 3600s
		}
	}

	header {
		# 反代后应用侧需要知道原始协议，登录 Cookie 才会带 Secure
		X-Forwarded-Proto {scheme}
		-Server
	}
}
